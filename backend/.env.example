# Server Configuration
APP_NAME="SportsTicketPlatform API"
DEBUG=True
PORT=8000

# PostgreSQL Connection (Raw SQL / Driver)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_ticket_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Settings
JWT_SECRET_KEY="change_this_to_a_super_secret_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
OTP_EXPIRE_SECONDS=120